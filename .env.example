# Copy this file to .env and adjust the values for your environment.

# --- Application ---
LITESTAR_SKIP_NODEENV_INSTALL=true
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:15433/app
DATABASE_ECHO=false
DATABASE_ECHO_POOL=false
DATABASE_POOL_DISABLE=false
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:16377/0

# --- Frontend (Vite dev server) ---
VITE_HOST=localhost
VITE_PORT=5174
VITE_HOT_RELOAD=true
VITE_DEV_MODE=true
VITE_USE_SERVER_LIFESPAN=false
